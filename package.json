{
  "name": "nagi-of-mekong",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Nagi of Mekong — two-day slow-boat cruises on the Mekong between Houay Xai and Luang Prabang.",
  "type": "module",
  "scripts": {
    "photos": "node scripts/build-photos.mjs",
    "predev": "npm run photos",
    "dev": "next dev",
    "prebuild": "npm run photos",
    "build": "next build",
    "start": "npx serve@14 out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:a11y": "node scripts/a11y-check.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "^16.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
