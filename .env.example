# Copy to .env.local (not committed) or set these in your host's build settings.
# Only public values belong here: NEXT_PUBLIC_* variables end up in the browser.

# Newsletter sign-up in the footer: "brevo" or "stub" (default: says "thank you", sends nothing).
NEXT_PUBLIC_NEWSLETTER_PROVIDER=stub

# Brevo: Contacts → Forms → your sign-up form → Share → copy the form's action URL
# (https://….sibforms.com/serve/…). Required when the provider is "brevo"; the build fails without it.
NEXT_PUBLIC_BREVO_FORM_URL=
